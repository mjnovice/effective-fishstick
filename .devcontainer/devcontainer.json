{
  "name": "Aurelian Interview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    "AURELIAN_HOST": "0.0.0.0"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Aurelian Interview App",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "workspace/app.py"
      ]
    },
    "vscode": {
      "settings": {
        "files.exclude": {
          "**/__pycache__": true
        }
      }
    }
  }
}
